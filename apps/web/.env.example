# --- Nest API (별도 호스트: Render / Fly / Cloud Run 등) -----------------
# Netlify·Vercel은 Next만 올리므로, 브라우저가 부를 API 베이스는 반드시 공개 HTTPS URL.
# 끝에 `/` 없이. 로컬 통합 개발이면 아래 기본값 그대로 두면 됨.
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# 채팅 — Next `app/api/chat` (서버 전용, 브라우저에 노출 금지)
#
# CHAT_PROVIDER — 선택, 기본값 auto
#   auto   : GEMINI_API_KEY가 있으면 Gemini 먼저, 쿼터/429류 실패 시 OPENAI_API_KEY로 자동 폴백
#   openai : OpenAI만 사용 (Gemini 키가 있어도 무시 — 쿼터 막혔을 때 이렇게 설정)
#   gemini : Gemini만 사용 (폴백 없음)
# CHAT_PROVIDER=openai
#
# GEMINI_API_KEY=...
# GEMINI_MODEL=gemini-2.0-flash
#
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
# 프로젝트에만 연결된 키일 때 Missing scopes: model.request 등이 나오면 대시보드 Project 설정의 proj_… ID를 넣는다.
# OPENAI_PROJECT_ID=proj_...
# OPENAI_ORGANIZATION=org-...

# `NEXT_PUBLIC_API_URL` 없으면 역할 결손·Prompt→Spec 등은 클라이언트 목업.
# 운영(Netlify) 빌드에서 위 둘 다 비우면 시뮼 `/`로 잘못 요청하지 않도록 API 베이스는 빈 값이 된다.
# 사용 엔드포인트 예:
# GET .../role-gap · POST .../prompt-spec/convert|approve
# GET .../pr-review · POST .../pr-review/submit|re-review|final-approve · PATCH .../pr-review/comments/:id
# POST .../contract/validate · POST .../contract/approve
# GET .../retro/reports · POST .../retro/generate
