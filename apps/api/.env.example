# API 포트 (기본 4000)
# API_PORT=4000

# PostgreSQL (TypeORM·사용자·시뮬 세션) — 루트 .env 의 DATABASE_URL 를 우선 사용한다.
# docs/collaboration-env-and-endpoints.md 참고

# SQLite 워크스페이스(PR·계약·회고 스냅샷). 기본: 프로젝트 루트 기준 data/usvibe.db
# DATABASE_PATH=./data/usvibe.db

# GitHub 웹훅으로 들어오는 이벤트의 sessionId (기본: github-ingest)
# 운영 모드 표(데모·CI·운영): docs/collaboration-env-and-endpoints.md §3.1
# INTEGRATION_WEBHOOK_SESSION_ID=github-ingest

# PR 정적 검증 상한(ms). 기본 28000 (동기 웹훅 응답용 레이스; 초과 시 큐로 이관)
# WEBHOOK_VALIDATION_MAX_MS=28000

# PR 정적 검증을 웹훅 요청 밖에서 순차 실행(1/true). PR 이벤트 발행 후 빨리 200 응답
# WEBHOOK_VALIDATION_ASYNC=0

# Redis(BullMQ)에 PR 검증 잡 적재 — INTEGRATION_BULLMQ=1 이면 REDIS_URL 필수. 미설정 시 인메모리 큐만 사용
# INTEGRATION_BULLMQ=0

# 운영에서 서명 없이 웹훅을 열지 않음(1/true 시 GITHUB_WEBHOOK_SECRET 필수)
# GITHUB_WEBHOOK_REQUIRE_SIGNATURE=0

# 웹훅 클라이언트 IP 허용(쉼표 구분). IPv4 단일 주소 또는 IPv4 CIDR. 비어 있으면 제한 없음
# WEBHOOK_ALLOWLIST=
# 별칭(동일 본문): WEBHOOK_ALLOWED_CIDRS
# 리버스 프록시 뒤에서 X-Forwarded-For 를 반영하려면 Express trust proxy + 아래 설정
# WEBHOOK_TRUST_PROXY=0

# Redis로 통합 이벤트 Pub/Sub (JWT 폐기와 동일 URL 가능, 채널만 분리)
# INTEGRATION_REDIS_PUBLISHER=1
# INTEGRATION_REDIS_CHANNEL=integration:events
# Pub/Sub publish 실패 시 재시도 (지수 백오프, 동일 프로세스)
# INTEGRATION_REDIS_PUBLISH_MAX_ATTEMPTS=3
# INTEGRATION_REDIS_PUBLISH_BACKOFF_MS=100

# 웹훅 서버에서 git·스크립트 경로 탐색 실패 시 모노레포 루트
# US_VIBE_REPO_ROOT=

# JWT (프로덕션에서는 반드시 강한 비밀값)
# JWT_SECRET=your-long-random-secret

# 최초 기동 시 관리자 1명 자동 생성(선택)
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASSWORD=change-me-8chars
