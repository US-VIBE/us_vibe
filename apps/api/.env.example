# API 포트 (기본 4000)
# API_PORT=4000

# PostgreSQL (TypeORM·사용자·시뮬 세션) — 루트 .env 의 DATABASE_URL 를 우선 사용한다.
# docs/collaboration-env-and-endpoints.md 참고

# SQLite 워크스페이스(PR·계약·회고 스냅샷). 기본: 프로젝트 루트 기준 data/usvibe.db
# DATABASE_PATH=./data/usvibe.db

# GitHub 웹훅으로 들어오는 이벤트의 sessionId (기본: github-ingest)
# INTEGRATION_WEBHOOK_SESSION_ID=github-ingest

# PR 정적 검증 상한(ms). 기본 28000
# WEBHOOK_VALIDATION_MAX_MS=28000

# Redis로 통합 이벤트 Pub/Sub (JWT 폐기와 동일 URL 가능, 채널만 분리)
# INTEGRATION_REDIS_PUBLISHER=1
# INTEGRATION_REDIS_CHANNEL=integration:events

# 웹훅 서버에서 git·스크립트 경로 탐색 실패 시 모노레포 루트
# US_VIBE_REPO_ROOT=

# JWT (프로덕션에서는 반드시 강한 비밀값)
# JWT_SECRET=your-long-random-secret

# 최초 기동 시 관리자 1명 자동 생성(선택)
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASSWORD=change-me-8chars
