# API 포트 (기본 4000)
# API_PORT=4000

# PostgreSQL (TypeORM·사용자·시뮬 세션) — 루트 .env 의 DATABASE_URL 를 우선 사용한다.
# docs/collaboration-env-and-endpoints.md 참고

# SQLite 워크스페이스(PR·계약·회고 스냅샷). 기본: 프로젝트 루트 기준 data/usvibe.db
# DATABASE_PATH=./data/usvibe.db

# GitHub 웹훅으로 들어오는 이벤트의 sessionId (개발 미설정 시 내부 기본값 사용)
# 프로덕션: UUID v4 필수 — docs/api/production-environment.md
# INTEGRATION_WEBHOOK_SESSION_ID=00000000-0000-4000-8000-000000000001

# PR 정적 검증 상한(ms). 기본 28000 (동기 웹훅 응답용 레이스; 초과 시 큐로 이관)
# WEBHOOK_VALIDATION_MAX_MS=28000

# PR 정적 검증을 웹훅 요청 밖에서 순차 실행(1/true). PR 이벤트 발행 후 빨리 200 응답
# WEBHOOK_VALIDATION_ASYNC=0

# PR 검증을 Redis BullMQ 큐(integration-pr-validate)에 적재 — REDIS_URL 있을 때만 실제 BullMQ 기동. 없으면 경고 후 인메모리 순차 큐
# INTEGRATION_BULLMQ=0

# API와 워커 프로세스 분리(P-2): 1/true 시 API는 Queue만, 워커는 별도 프로세스
# INTEGRATION_BULLMQ_SEPARATE_WORKER=0
# 워커 전용: apps/api 에서 `npm run start:bullmq-worker` (또는 dist 직접 실행). bullmq-worker-env 가 BULLMQ_PROCESS_ROLE=worker 설정
# BULLMQ_PROCESS_ROLE=api

# 운영에서 서명 없이 웹훅을 열지 않음(1/true 시 GITHUB_WEBHOOK_SECRET 필수)
# GITHUB_WEBHOOK_REQUIRE_SIGNATURE=0

# 웹훅 클라이언트 IP 허용(쉼표 구분). IPv4 단일 주소 또는 IPv4 CIDR. 비어 있으면 제한 없음
# WEBHOOK_ALLOWLIST=
# 별칭(동일 본문): WEBHOOK_ALLOWED_CIDRS
# 리버스 프록시·trust proxy·허용 목록 켜는 순서: docs/collaboration-env-and-endpoints.md 절 3.2
# WEBHOOK_TRUST_PROXY=0

# Redis로 통합 이벤트 Pub/Sub (JWT 폐기와 동일 URL 가능, 채널만 분리)
# INTEGRATION_REDIS_PUBLISHER=1
# INTEGRATION_REDIS_CHANNEL=integration:events
# Pub/Sub publish 실패 시 재시도 (지수 백오프, 동일 프로세스)
# INTEGRATION_REDIS_PUBLISH_MAX_ATTEMPTS=3
# INTEGRATION_REDIS_PUBLISH_BACKOFF_MS=100

# Pub/Sub 동기 재시도까지 실패 시 BullMQ 큐 integration-redis-replay 로 비동기 재발행 (INTEGRATION_BULLMQ=1 + REDIS_URL)
# INTEGRATION_REDIS_REPLAY_QUEUE=0

# 웹훅 서버에서 git·스크립트 경로 탐색 실패 시 모노레포 루트
# US_VIBE_REPO_ROOT=

# OpenAI — 워크스페이스 산출물 AI 비전 평가(POST .../artifacts/:id/evaluate). 루트 .env 와 공유 가능.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_ORGANIZATION=
# OPENAI_PROJECT_ID=

# Google Gemini — 시나리오 AI(POST /sessions/.../run-scenario) 등. 산출물 평가는 OpenAI 경로만 사용.
# GEMINI_API_KEY=
# GEMINI_MODEL=
# GEMINI_FALLBACK_MODEL=

# JWT (프로덕션에서는 반드시 강한 비밀값, 32자 이상)
# JWT_SECRET=your-long-random-secret-at-least-32-chars

# 프로덕션 CORS (NODE_ENV=production 일 때 필수, 쉼표 구분)
# API_CORS_ORIGINS=https://app.example.com,http://localhost:3000

# 프로덕션 웹훅 강제 완화(비권장): 웹훅 시크릿·서명·IP 목록 검사 생략
# SKIP_PRODUCTION_WEBHOOK_ENFORCEMENT=1

# 최초 기동 시 관리자 1명 자동 생성(선택)
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASSWORD=change-me-8chars
