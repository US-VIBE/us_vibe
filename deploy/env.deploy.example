# deploy/.env.deploy 로 복사한 뒤 서버에만 두세요 (git에 올리지 않음).

# 브라우저가 API를 부를 수 있는 공개 URL (프로토콜+호스트+포트)
NEXT_PUBLIC_API_BASE_URL=http://YOUR_SERVER_IP:4000

# API 컨테이너 기본값과 맞추려면 compose 기본 postgres 사용 시:
# DATABASE_URL=postgres://postgres:postgres@postgres:5432/usvibe
DATABASE_URL=postgres://postgres:postgres@postgres:5432/usvibe

# JWT 등 (앱에서 쓰는 경우)
# JWT_SECRET=

# 호스트에 노출할 포트 (선택, compose 기본 3000/4000)
# WEB_PUBLISH_PORT=3000
# API_PUBLISH_PORT=4000
# POSTGRES_PASSWORD=postgres
